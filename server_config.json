{
  "server": {
    "default_port": 8000,
    "host": "localhost",
    "auto_open_browser": true,
    "enable_cors": true
  },
  "paths": {
    "web_root": "chennai_guide/web",
    "static_files": ["styles.css", "app.js", "browse.js", "help.js"],
    "context_file": "product.md"
  },
  "api": {
    "endpoints": {
      "/api/query": "Main query processing endpoint",
      "/api/health": "Health check and component status",
      "/api/browse": "Browse categories and discovery",
      "/api/inspiration": "Content inspiration engine"
    },
    "max_query_length": 1000,
    "response_timeout": 30
  },
  "logging": {
    "level": "INFO",
    "format": "[%(asctime)s] %(levelname)s: %(message)s",
    "log_requests": true
  },
  "development": {
    "auto_reload": true,
    "debug_mode": false,
    "show_backend_errors": true
  },
  "production": {
    "auto_reload": false,
    "debug_mode": false,
    "show_backend_errors": false,
    "enable_gzip": true
  }
}